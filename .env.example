# TruthNet AI Environment Configuration

# Neo4j Settings (Use Bolt URL for AuraDB or local Neo4j instance)
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=password

# JWT Security Settings (Must be at least 256-bit / 64-character hex string in production)
JWT_SECRET=9a4f2c8d3b7a1e5f8c2e6d9b0a3f4e7c1b5d8e2f9a3c6b0d1e4f7a2c5b8d0e3f
JWT_EXPIRATION_MS=86400000

# Gemini API Key (Required for scam detection and entity extraction)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Tesseract OCR Data Directory
# Set to custom path on Windows or keep default for container deployment
TESSERACT_DATA_PATH=tessdata
